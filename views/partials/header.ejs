<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Website Học Trực Tuyến' %></title>
  <!-- Dùng Bootstrap qua CDN để có giao diện đẹp nhanh, không cần cài đặt -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
    <div class="container">
      <a class="navbar-brand" href="/">Học Trực Tuyến</a>
      <div class="d-flex">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <span class="navbar-text text-white me-3">Xin chào, <%= currentUser.full_name %></span>
          <a href="/logout" class="btn btn-outline-light btn-sm">Đăng xuất</a>
        <% } %>
      </div>
    </div>
  </nav>
  <div class="container">
