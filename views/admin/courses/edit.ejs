<%- include('../../partials/header') %>

<div class="max-w-xl mx-auto space-y-6">

  <!-- Breadcrumb -->
  <nav class="text-xs font-mono text-neutral-500 flex items-center gap-2">
    <a href="/admin/courses" class="hover:text-black transition">&larr; quay lại quản lý khóa học</a>
    <span>/</span>
    <span class="text-black truncate max-w-xs"><%= course.title %></span>
    <span>/</span>
    <span class="text-neutral-400">sửa</span>
  </nav>

  <!-- Header -->
  <div>
    <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-black">
      Chỉnh sửa khóa học
    </h1>
    <p class="text-xs sm:text-sm text-neutral-500 mt-1">
      Cập nhật thông tin chi tiết cho khóa học trên hệ thống.
    </p>
  </div>

  <!-- Form Card -->
  <div class="bg-white rounded-2xl border border-[#e5e5e5] p-6 sm:p-8">
    
    <% if (error) { %>
      <div class="mb-5 flex items-center gap-2 p-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
        <span><%= error %></span>
      </div>
    <% } %>

    <form method="POST" action="/admin/courses/<%= course.id %>?_method=PUT" class="space-y-4">
      
      <!-- Course Title -->
      <div>
        <label class="block text-xs font-medium text-neutral-700 mb-1.5 ml-1">
          Tên khóa học <span class="text-red-500">*</span>
        </label>
        <input 
          type="text" 
          name="title" 
          value="<%= course.title %>"
          class="w-full px-4 py-2 rounded-full border border-[#e5e5e5] text-black placeholder-neutral-400 text-sm focus:outline-none focus:border-black transition bg-white"
          required
        >
      </div>

      <!-- Description -->
      <div>
        <label class="block text-xs font-medium text-neutral-700 mb-1.5 ml-1">
          Mô tả khóa học
        </label>
        <textarea 
          name="description" 
          rows="4" 
          class="w-full px-4 py-2.5 rounded-2xl border border-[#e5e5e5] text-black placeholder-neutral-400 text-sm focus:outline-none focus:border-black transition bg-white leading-relaxed"
        ><%= course.description || '' %></textarea>
      </div>

      <!-- Image URL -->
      <div>
        <label class="block text-xs font-medium text-neutral-700 mb-1.5 ml-1">
          URL hình ảnh bìa
        </label>
        <input 
          type="text" 
          name="image" 
          value="<%= course.image || '' %>"
          placeholder="https://images.unsplash.com/..." 
          class="w-full px-4 py-2 rounded-full border border-[#e5e5e5] text-black placeholder-neutral-400 text-sm focus:outline-none focus:border-black transition bg-white"
        >
      </div>

      <!-- Form Actions -->
      <div class="pt-4 border-t border-[#e5e5e5] flex items-center justify-end gap-2.5">
        <a 
          href="/admin/courses" 
          class="px-4 py-2 rounded-full text-xs font-medium text-neutral-600 hover:text-black hover:bg-[#fafafa] border border-transparent hover:border-[#e5e5e5] transition"
        >
          Hủy bỏ
        </a>
        <button 
          type="submit" 
          class="inline-flex items-center gap-2 px-6 py-2 rounded-full bg-black text-white hover:bg-neutral-800 text-xs font-medium shadow-sm transition active:scale-95"
        >
          <span>Lưu thay đổi</span>
          <i class="fa-solid fa-arrow-right text-[9px]"></i>
        </button>
      </div>

    </form>

  </div>

</div>

<%- include('../../partials/footer') %>
