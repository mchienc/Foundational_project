<%- include('../../partials/header') %>

<div class="max-w-2xl mx-auto space-y-6">

  <!-- Breadcrumb -->
  <nav class="text-xs font-mono text-neutral-500 flex items-center gap-2">
    <a href="/admin/courses" class="hover:text-black transition">quản lý khóa học</a>
    <span>/</span>
    <a href="/admin/courses/<%= course.id %>/lessons" class="hover:text-black transition truncate max-w-xs"><%= course.title %></a>
    <span>/</span>
    <span class="text-black">thêm bài học</span>
  </nav>

  <!-- Header -->
  <div>
    <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-black">
      Thêm bài học mới
    </h1>
    <p class="text-xs sm:text-sm text-neutral-500 mt-1">
      Khóa học: <strong class="text-black"><%= course.title %></strong>
    </p>
  </div>

  <!-- Form Card -->
  <div class="bg-white rounded-2xl border border-[#e5e5e5] p-6 sm:p-8">
    
    <% if (error) { %>
      <div class="mb-5 flex items-center gap-2 p-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
        <span><%= error %></span>
      </div>
    <% } %>

    <form method="POST" action="/admin/courses/<%= course.id %>/lessons" class="space-y-4">
      
      <!-- Lesson Title -->
      <div>
        <label class="block text-xs font-medium text-neutral-700 mb-1.5 ml-1">
          Tiêu đề bài học <span class="text-red-500">*</span>
        </label>
        <input 
          type="text" 
          name="title" 
          placeholder="Ví dụ: Giới thiệu kiến trúc MVC trong Express" 
          class="w-full px-4 py-2 rounded-full border border-[#e5e5e5] text-black placeholder-neutral-400 text-sm focus:outline-none focus:border-black transition bg-white"
          required
        >
      </div>

      <!-- Order Index -->
      <div>
        <label class="block text-xs font-medium text-neutral-700 mb-1.5 ml-1">
          Thứ tự hiển thị
        </label>
        <input 
          type="number" 
          name="order_index" 
          value="1" 
          min="1"
          class="w-32 px-4 py-2 rounded-full border border-[#e5e5e5] text-black text-sm focus:outline-none focus:border-black transition bg-white font-mono"
        >
      </div>

      <!-- Video URL (Optional) -->
      <div>
        <label class="block text-xs font-medium text-neutral-700 mb-1.5 ml-1">
          URL Video bài giảng (YouTube, Vimeo, MP4 - Tùy chọn)
        </label>
        <input 
          type="url" 
          name="video_url" 
          placeholder="https://www.youtube.com/watch?v=..." 
          class="w-full px-4 py-2 rounded-full border border-[#e5e5e5] text-black placeholder-neutral-400 text-sm focus:outline-none focus:border-black transition bg-white"
        >
        <p class="text-[11px] font-mono text-neutral-400 mt-1 ml-2">Tự động nhận diện và nhúng video YouTube / Vimeo.</p>
      </div>

      <!-- Attachment URL (Optional) -->
      <div>
        <label class="block text-xs font-medium text-neutral-700 mb-1.5 ml-1">
          URL Tài liệu đính kèm (Link PDF, Google Drive, Slide - Tùy chọn)
        </label>
        <input 
          type="url" 
          name="attachment_url" 
          placeholder="https://example.com/tai-lieu-bai-giang.pdf" 
          class="w-full px-4 py-2 rounded-full border border-[#e5e5e5] text-black placeholder-neutral-400 text-sm focus:outline-none focus:border-black transition bg-white"
        >
      </div>

      <!-- Content -->
      <div>
        <div class="flex items-center justify-between mb-1.5 ml-1">
          <label class="text-xs font-medium text-neutral-700">
            Nội dung bài học (Hỗ trợ HTML / Markdown)
          </label>
          <span class="text-[11px] font-mono text-neutral-400">html tags supported</span>
        </div>
        <textarea 
          name="content" 
          rows="10" 
          placeholder="<p>Soạn nội dung bài học tại đây...</p>" 
          class="w-full p-4 rounded-2xl border border-[#e5e5e5] text-black placeholder-neutral-400 text-sm font-mono focus:outline-none focus:border-black transition bg-white leading-relaxed"
        ></textarea>
      </div>

      <!-- Form Actions -->
      <div class="pt-4 border-t border-[#e5e5e5] flex items-center justify-end gap-2.5">
        <a 
          href="/admin/courses/<%= course.id %>/lessons" 
          class="px-4 py-2 rounded-full text-xs font-medium text-neutral-600 hover:text-black hover:bg-[#fafafa] border border-transparent hover:border-[#e5e5e5] transition"
        >
          Hủy bỏ
        </a>
        <button 
          type="submit" 
          class="inline-flex items-center gap-2 px-6 py-2 rounded-full bg-black text-white hover:bg-neutral-800 text-xs font-medium shadow-sm transition active:scale-95"
        >
          <span>Lưu bài học</span>
          <i class="fa-solid fa-arrow-right text-[9px]"></i>
        </button>
      </div>

    </form>

  </div>

</div>

<%- include('../../partials/footer') %>
