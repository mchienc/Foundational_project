<%- include('../../partials/header') %>

<div class="mb-3">
  <a href="/admin/courses" class="text-decoration-none">&larr; Quay lại danh sách khóa học</a>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h3>Bài học của khóa: <%= course.title %></h3>
  <a href="/admin/courses/<%= course.id %>/lessons/new" class="btn btn-primary">+ Thêm bài học</a>
</div>

<% if (lessons.length === 0) { %>
  <p class="text-muted">Chưa có bài học nào trong khóa học này.</p>
<% } else { %>
  <table class="table table-bordered bg-white">
    <thead class="table-light">
      <tr>
        <th style="width: 80px;">Thứ tự</th>
        <th>Tên bài học</th>
        <th style="width: 260px;">Hành động</th>
      </tr>
    </thead>
    <tbody>
      <% lessons.forEach((lesson) => { %>
        <tr>
          <td><%= lesson.order_index %></td>
          <td><%= lesson.title %></td>
          <td>
            <a href="/admin/courses/<%= course.id %>/lessons/<%= lesson.id %>/edit" class="btn btn-sm btn-warning">Sửa</a>
            <form action="/admin/courses/<%= course.id %>/lessons/<%= lesson.id %>?_method=DELETE" method="POST" class="d-inline"
                  onsubmit="return confirm('Xóa bài học này?');">
              <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../../partials/footer') %>
