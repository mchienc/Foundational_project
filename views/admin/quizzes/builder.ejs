<%- include('../../partials/header') %>

<div class="max-w-3xl mx-auto space-y-8">

  <!-- Breadcrumb Navigation -->
  <nav class="text-xs font-mono text-neutral-500 flex items-center gap-2">
    <a href="/admin/courses" class="hover:text-black transition">quản lý khóa học</a>
    <span>/</span>
    <a href="/admin/courses/<%= course.id %>/lessons" class="hover:text-black transition truncate max-w-xs"><%= course.title %></a>
    <span>/</span>
    <span class="text-black truncate max-w-xs"><%= lesson.title %></span>
    <span>/</span>
    <span class="text-neutral-400">quiz builder</span>
  </nav>

  <!-- Header Section -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-[#e5e5e5]">
    <div>
      <div class="text-xs font-mono text-neutral-400 mb-1">
        assessment builder / soạn đề trắc nghiệm
      </div>
      <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-black">
        Quản lý bài kiểm tra
      </h1>
      <p class="text-sm text-neutral-500 mt-1">
        Bài giảng: <strong class="text-black"><%= lesson.title %></strong>
      </p>
    </div>

    <% if (quiz) { %>
      <!-- Delete Entire Quiz Button -->
      <form 
        action="/admin/courses/<%= course.id %>/lessons/<%= lesson.id %>/quiz?_method=DELETE" 
        method="POST"
        onsubmit="return confirm('Xác nhận xóa toàn bộ bài kiểm tra này cùng tất cả câu hỏi và lịch sử kết quả của học viên?');"
        class="self-start sm:self-auto"
      >
        <button 
          type="submit" 
          class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-red-50 border border-red-200 text-red-600 hover:bg-red-100 text-xs font-medium transition"
        >
          <i class="fa-regular fa-trash-can text-[10px]"></i>
          <span>Xóa bài quiz</span>
        </button>
      </form>
    <% } %>
  </div>

  <!-- Status Feedback Alerts -->
  <% if (error) { %>
    <div class="flex items-center gap-2 p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs font-mono">
      <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
      <span><%= error %></span>
    </div>
  <% } %>

  <% if (success) { %>
    <div class="flex items-center gap-2 p-3.5 rounded-xl bg-[#fafafa] border border-[#e5e5e5] text-black text-xs font-mono">
      <span class="w-1.5 h-1.5 rounded-full bg-[#27c93f]"></span>
      <span><%= success %></span>
    </div>
  <% } %>

  <!-- Card 1: Quiz Title Configuration -->
  <div class="bg-white border border-[#e5e5e5] rounded-2xl p-6 space-y-4">
    <div class="flex items-center justify-between">
      <h3 class="text-sm font-semibold text-black uppercase font-mono tracking-wider">
        Tiêu đề bài kiểm tra
      </h3>
      <span class="text-xs font-mono text-neutral-400">
        <%= quiz ? 'đã cấu hình' : 'chưa khởi tạo' %>
      </span>
    </div>

    <form action="/admin/courses/<%= course.id %>/lessons/<%= lesson.id %>/quiz" method="POST" class="flex flex-col sm:flex-row gap-3">
      <input 
        type="text" 
        name="title" 
        value="<%= quiz ? quiz.title : `Kiểm tra: ${lesson.title}` %>" 
        placeholder="Ví dụ: Kiểm tra trắc nghiệm kiến thức bài 1" 
        class="flex-1 px-4 py-2 rounded-full border border-[#e5e5e5] text-black placeholder-neutral-400 text-sm focus:outline-none focus:border-black transition bg-white"
        required
      >
      <button 
        type="submit" 
        class="px-6 py-2 rounded-full bg-black text-white hover:bg-neutral-800 text-xs font-medium transition shadow-sm shrink-0"
      >
        <%= quiz ? 'Cập nhật tiêu đề' : 'Tạo bài kiểm tra' %>
      </button>
    </form>
  </div>

  <!-- Card 2: Existing Questions List -->
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-base font-semibold text-black">
        Danh sách câu hỏi trắc nghiệm
      </h2>
      <span class="text-xs font-mono text-neutral-400">
        <%= questions.length %> câu hỏi
      </span>
    </div>

    <% if (questions.length === 0) { %>
      <div class="border border-dashed border-[#e5e5e5] bg-white p-10 text-center rounded-2xl space-y-2">
        <div class="w-10 h-10 rounded-full bg-[#fafafa] border border-[#e5e5e5] text-neutral-400 flex items-center justify-center mx-auto text-sm font-mono">
          <i class="fa-solid fa-clipboard-question"></i>
        </div>
        <p class="text-xs text-neutral-600 font-medium">Bài kiểm tra này chưa có câu hỏi nào.</p>
        <p class="text-xs text-neutral-400">Sử dụng form bên dưới để tạo câu hỏi đầu tiên kèm 4 đáp án.</p>
      </div>
    <% } else { %>
      <div class="space-y-4">
        <% questions.forEach((q, qIndex) => { %>
          <div class="bg-white border border-[#e5e5e5] rounded-2xl p-5 sm:p-6 space-y-4 hover:border-neutral-300 transition">
            
            <!-- Question Title & Delete Action -->
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-[#fafafa] border border-[#e5e5e5] text-neutral-700 flex items-center justify-center font-mono font-bold text-xs shrink-0 mt-0.5">
                  <%= qIndex + 1 %>
                </span>
                <h3 class="text-sm sm:text-base font-semibold text-black leading-snug">
                  <%= q.question_text %>
                </h3>
              </div>

              <!-- Delete Question Form -->
              <form 
                action="/admin/courses/<%= course.id %>/lessons/<%= lesson.id %>/quiz/questions/<%= q.id %>?_method=DELETE" 
                method="POST"
                onsubmit="return confirm('Xác nhận xóa câu hỏi này?');"
                class="shrink-0"
              >
                <button 
                  type="submit" 
                  title="Xóa câu hỏi" 
                  class="p-1.5 px-2.5 rounded-full text-xs font-mono text-neutral-400 hover:text-red-600 hover:bg-red-50 border border-transparent hover:border-red-200 transition"
                >
                  <i class="fa-regular fa-trash-can text-[10px]"></i>
                  <span class="hidden sm:inline ml-1">xóa</span>
                </button>
              </form>
            </div>

            <!-- Answers List with Highlight for the Correct One -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
              <% const optionLabels = ['A', 'B', 'C', 'D']; %>
              <% q.answers.forEach((ans, aIndex) => { %>
                <div class="p-2.5 rounded-xl border text-xs flex items-center justify-between gap-2 transition <%= ans.is_correct ? 'border-emerald-300 bg-emerald-50/40 text-black font-medium' : 'border-[#e5e5e5] bg-[#fafafa] text-neutral-600' %>">
                  <div class="flex items-center gap-2 min-w-0">
                    <span class="w-5 h-5 rounded-full <%= ans.is_correct ? 'bg-black text-white' : 'bg-white border border-[#e5e5e5] text-neutral-500' %> flex items-center justify-center font-mono text-[10px] shrink-0 font-semibold">
                      <%= optionLabels[aIndex] || (aIndex + 1) %>
                    </span>
                    <span class="truncate"><%= ans.answer_text %></span>
                  </div>

                  <% if (ans.is_correct) { %>
                    <span class="inline-flex items-center gap-1 text-[10px] font-mono text-emerald-700 shrink-0">
                      <span class="w-1.5 h-1.5 rounded-full bg-[#27c93f]"></span>
                      đáp án đúng
                    </span>
                  <% } %>
                </div>
              <% }) %>
            </div>

          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- Card 3: Question Builder Form -->
  <div class="bg-white border border-[#e5e5e5] rounded-2xl p-6 sm:p-8 space-y-6">
    <div class="border-b border-[#e5e5e5] pb-4">
      <div class="text-xs font-mono text-neutral-400 mb-1">
        question composer
      </div>
      <h2 class="text-lg font-semibold text-black">
        Thêm câu hỏi mới
      </h2>
      <p class="text-xs text-neutral-500 mt-0.5">
        Nhập nội dung câu hỏi, cung cấp 4 lựa chọn và chọn ô tròn của đáp án đúng.
      </p>
    </div>

    <form action="/admin/courses/<%= course.id %>/lessons/<%= lesson.id %>/quiz/questions" method="POST" class="space-y-5">
      
      <!-- Question Text -->
      <div>
        <label class="block text-xs font-medium text-neutral-700 mb-1.5 ml-1">
          Nội dung câu hỏi <span class="text-red-500">*</span>
        </label>
        <textarea 
          name="question_text" 
          rows="3" 
          placeholder="Ví dụ: Phương thức HTTP nào được sử dụng để gửi dữ liệu lên server tạo tài nguyên mới?" 
          class="w-full px-4 py-2.5 rounded-2xl border border-[#e5e5e5] text-black placeholder-neutral-400 text-sm focus:outline-none focus:border-black transition bg-white leading-relaxed"
          required
        ></textarea>
      </div>

      <!-- 4 Answer Options -->
      <div class="space-y-3">
        <div class="flex items-center justify-between ml-1">
          <label class="text-xs font-medium text-neutral-700">
            Các lựa chọn trả lời (Tích chọn đáp án đúng) <span class="text-red-500">*</span>
          </label>
          <span class="text-[11px] font-mono text-neutral-400">click radio để chọn đáp án đúng</span>
        </div>

        <!-- Option A -->
        <div class="flex items-center gap-3 p-2 rounded-2xl border border-[#e5e5e5] bg-[#fafafa] hover:border-neutral-400 transition">
          <label class="flex items-center gap-2 cursor-pointer shrink-0 pl-2">
            <input type="radio" name="correct_answer" value="a" checked class="w-4 h-4 accent-black cursor-pointer">
            <span class="w-5 h-5 rounded-full bg-black text-white flex items-center justify-center font-mono text-[10px] font-semibold">A</span>
          </label>
          <input 
            type="text" 
            name="answer_a" 
            placeholder="Nội dung đáp án A..." 
            class="flex-1 px-3 py-1.5 rounded-full border border-[#e5e5e5] text-black placeholder-neutral-400 text-xs sm:text-sm focus:outline-none focus:border-black transition bg-white"
            required
          >
        </div>

        <!-- Option B -->
        <div class="flex items-center gap-3 p-2 rounded-2xl border border-[#e5e5e5] bg-[#fafafa] hover:border-neutral-400 transition">
          <label class="flex items-center gap-2 cursor-pointer shrink-0 pl-2">
            <input type="radio" name="correct_answer" value="b" class="w-4 h-4 accent-black cursor-pointer">
            <span class="w-5 h-5 rounded-full bg-black text-white flex items-center justify-center font-mono text-[10px] font-semibold">B</span>
          </label>
          <input 
            type="text" 
            name="answer_b" 
            placeholder="Nội dung đáp án B..." 
            class="flex-1 px-3 py-1.5 rounded-full border border-[#e5e5e5] text-black placeholder-neutral-400 text-xs sm:text-sm focus:outline-none focus:border-black transition bg-white"
            required
          >
        </div>

        <!-- Option C -->
        <div class="flex items-center gap-3 p-2 rounded-2xl border border-[#e5e5e5] bg-[#fafafa] hover:border-neutral-400 transition">
          <label class="flex items-center gap-2 cursor-pointer shrink-0 pl-2">
            <input type="radio" name="correct_answer" value="c" class="w-4 h-4 accent-black cursor-pointer">
            <span class="w-5 h-5 rounded-full bg-black text-white flex items-center justify-center font-mono text-[10px] font-semibold">C</span>
          </label>
          <input 
            type="text" 
            name="answer_c" 
            placeholder="Nội dung đáp án C..." 
            class="flex-1 px-3 py-1.5 rounded-full border border-[#e5e5e5] text-black placeholder-neutral-400 text-xs sm:text-sm focus:outline-none focus:border-black transition bg-white"
            required
          >
        </div>

        <!-- Option D -->
        <div class="flex items-center gap-3 p-2 rounded-2xl border border-[#e5e5e5] bg-[#fafafa] hover:border-neutral-400 transition">
          <label class="flex items-center gap-2 cursor-pointer shrink-0 pl-2">
            <input type="radio" name="correct_answer" value="d" class="w-4 h-4 accent-black cursor-pointer">
            <span class="w-5 h-5 rounded-full bg-black text-white flex items-center justify-center font-mono text-[10px] font-semibold">D</span>
          </label>
          <input 
            type="text" 
            name="answer_d" 
            placeholder="Nội dung đáp án D..." 
            class="flex-1 px-3 py-1.5 rounded-full border border-[#e5e5e5] text-black placeholder-neutral-400 text-xs sm:text-sm focus:outline-none focus:border-black transition bg-white"
            required
          >
        </div>
      </div>

      <!-- Submit Button -->
      <div class="pt-4 border-t border-[#e5e5e5] flex items-center justify-end">
        <button 
          type="submit" 
          class="inline-flex items-center gap-2 px-7 py-2.5 rounded-full bg-black text-white hover:bg-neutral-800 text-xs font-medium transition shadow-sm active:scale-95"
        >
          <i class="fa-solid fa-plus text-[10px]"></i>
          <span>Thêm câu hỏi này vào đề</span>
        </button>
      </div>

    </form>
  </div>

</div>

<%- include('../../partials/footer') %>
