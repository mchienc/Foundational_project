<%- include('partials/header') %>

<div class="space-y-16 py-6">

  <!-- Ollama Signature Center Hero -->
  <div class="text-center max-w-2xl mx-auto space-y-5">
    
    <!-- Minimal Mascot / Pill Tag -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#fafafa] border border-[#e5e5e5] text-xs font-mono text-neutral-600">
      <span class="w-2 h-2 rounded-full bg-black"></span>
      <span><%= user.role === 'admin' ? 'eduflow / admin-workspace' : 'eduflow / student-space' %></span>
    </div>

    <!-- 36px Center Headline (Ollama display-xl) -->
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-black leading-tight">
      Nền tảng học tập tinh giản và hiệu quả.
    </h1>

    <p class="text-neutral-500 text-sm sm:text-base max-w-lg mx-auto leading-relaxed">
      Xin chào <strong><%= user.full_name %></strong>. Tiếp cận bài giảng, tham gia khảo sát trắc nghiệm và nắm bắt kiến thức một cách tập trung nhất.
    </p>

    <!-- Ollama-style Terminal Command Snippet Pill -->
    <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
      <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-[#fafafa] border border-[#e5e5e5] font-mono text-xs text-neutral-800 select-all">
        <span class="text-neutral-400">$</span>
        <span>eduflow run <%= user.role === 'admin' ? 'manage --courses' : 'learn --interactive' %></span>
        <button type="button" onclick="navigator.clipboard.writeText('eduflow run learn')" class="text-neutral-400 hover:text-black transition" title="Sao chép lệnh">
          <i class="fa-regular fa-copy text-[11px]"></i>
        </button>
      </div>

      <!-- Single Black Pill CTA (Ollama Primary Button) -->
      <% if (user.role === 'admin') { %>
        <a href="/admin/courses" class="inline-flex items-center gap-2 px-6 py-2 rounded-full bg-black text-white hover:bg-neutral-800 text-sm font-medium transition active:scale-98 shadow-sm">
          <span>Quản lý khóa học</span>
          <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      <% } else { %>
        <a href="/courses" class="inline-flex items-center gap-2 px-6 py-2 rounded-full bg-black text-white hover:bg-neutral-800 text-sm font-medium transition active:scale-98 shadow-sm">
          <span>Bắt đầu học ngay</span>
          <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      <% } %>
    </div>

  </div>

  <!-- Ollama Signature Terminal Card with macOS Traffic Lights -->
  <div class="max-w-2xl mx-auto">
    <div class="bg-white border border-[#e5e5e5] rounded-2xl overflow-hidden">
      <!-- Terminal Header with 3 dots -->
      <div class="px-4 py-3 bg-[#fafafa] border-b border-[#e5e5e5] flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#ff5f56] inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-[#ffbd2e] inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-[#27c93f] inline-block"></span>
        </div>
        <span class="font-mono text-[11px] text-neutral-400">bash — eduflow-cli</span>
        <div class="w-10"></div>
      </div>

      <!-- Terminal Body -->
      <div class="p-5 font-mono text-xs text-neutral-800 space-y-2 leading-relaxed bg-white">
        <p><span class="text-neutral-400">$</span> eduflow status</p>
        <p class="text-neutral-500">Tài khoản: <%= user.email %> (<%= user.role %>)</p>
        <p><span class="text-neutral-400">$</span> eduflow progress-engine</p>
        <p class="text-emerald-600">[✓] Hệ thống theo dõi tiến độ bài học & khóa học đã kích hoạt.</p>
        <p class="text-neutral-500">[i] Hệ thống bài kiểm tra trắc nghiệm chấm điểm tự động đã sẵn sàng.</p>
      </div>
    </div>
  </div>

  <!-- Cards Grid with Ollama's Inverted Dark Card Rhythm -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    
    <!-- White Card 1 -->
    <div class="bg-white border border-[#e5e5e5] rounded-2xl p-6 flex flex-col justify-between hover:border-neutral-300 transition">
      <div>
        <div class="w-8 h-8 rounded-full bg-[#fafafa] border border-[#e5e5e5] flex items-center justify-center text-black mb-4">
          <i class="fa-solid fa-book-open text-xs"></i>
        </div>
        <h3 class="text-base font-semibold text-black mb-1.5">
          Khóa học tuyển chọn
        </h3>
        <p class="text-xs text-neutral-500 leading-relaxed">
          Bài giảng được cấu trúc chặt chẽ, tài liệu ngắn gọn và tập trung vào nội dung chính.
        </p>
      </div>
      <div class="pt-5 mt-4 border-t border-[#e5e5e5]">
        <a href="/courses" class="inline-flex items-center gap-1.5 text-xs font-semibold text-black hover:underline">
          <span>Xem danh sách</span>
          <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>
    </div>

    <!-- White Card 2 -->
    <div class="bg-white border border-[#e5e5e5] rounded-2xl p-6 flex flex-col justify-between hover:border-neutral-300 transition">
      <div>
        <div class="w-8 h-8 rounded-full bg-[#fafafa] border border-[#e5e5e5] flex items-center justify-center text-black mb-4">
          <i class="fa-solid fa-square-check text-xs"></i>
        </div>
        <h3 class="text-base font-semibold text-black mb-1.5">
          Khảo sát & Đánh giá
        </h3>
        <p class="text-xs text-neutral-500 leading-relaxed">
          Làm bài trắc nghiệm sau bài học, nhận kết quả tức thì và xem lại lịch sử làm bài.
        </p>
      </div>
      <div class="pt-5 mt-4 border-t border-[#e5e5e5]">
        <a href="/my-results" class="inline-flex items-center gap-1.5 text-xs font-semibold text-black hover:underline">
          <span>Xem kết quả</span>
          <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>
    </div>

    <!-- Ollama Signature Inverted Dark Card (surface-dark #171717) -->
    <div class="bg-[#171717] text-white rounded-2xl p-6 flex flex-col justify-between">
      <div>
        <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-white mb-4">
          <i class="fa-solid fa-shield-halved text-xs"></i>
        </div>
        <h3 class="text-base font-semibold text-white mb-1.5">
          Dữ liệu của bạn là của bạn
        </h3>
        <p class="text-xs text-neutral-400 leading-relaxed">
          Tài khoản và tiến độ học tập được bảo mật nghiêm ngặt theo tiêu chuẩn tinh gọn.
        </p>
      </div>
      <div class="pt-5 mt-4 border-t border-neutral-800 flex items-center justify-between text-xs">
        <span class="text-neutral-400 font-mono text-[11px]">local & secure</span>
        <span class="w-2 h-2 rounded-full bg-[#27c93f]"></span>
      </div>
    </div>

  </div>

</div>

<%- include('partials/footer') %>
