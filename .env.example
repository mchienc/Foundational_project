# Thông tin kết nối MySQL (mặc định của XAMPP)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=online_learning
DB_PORT=3306

# Cổng chạy server Node.js
PORT=3000

# Khóa bí mật cho session (bạn có thể đổi thành chuỗi bất kỳ, càng phức tạp càng tốt)
SESSION_SECRET=day_la_chuoi_bi_mat_cua_ban_hay_doi_no

# Cấu hình lưu trữ đám mây Cloudflare R2 (10GB Free / Không tốn phí băng thông phát audio)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=eduflow-audio
R2_PUBLIC_URL=https://pub-your_subdomain.r2.dev

# Đường dẫn phát audio cho Frontend (Local fallback: /audio/ hoặc Link R2.dev)
VITE_AUDIO_URL=https://pub-your_subdomain.r2.dev/
