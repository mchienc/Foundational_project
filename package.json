{
  "name": "online-learning-website",
  "version": "1.0.0",
  "description": "EduFlow — Nền tảng luyện thi Cambridge IELTS & Anki SRS",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"nodemon app.js\" \"npm --prefix frontend run dev\"",
    "client": "npm --prefix frontend run dev",
    "server": "nodemon app.js",
    "build": "npm install && (npm --prefix frontend install && npm --prefix frontend run build || echo 'Frontend build skipped, using prebuilt dist')",
    "client:build": "npm --prefix frontend run build",
    "client:preview": "npm --prefix frontend run preview",
    "db:seed:cambridge": "node scripts/seedCambridgeData.js",
    "db:seed:all": "node scripts/seedAllCambridge.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "mysql2": "^3.10.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1029.0",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.4"
  }
}
