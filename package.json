{
  "name": "online-learning-website",
  "version": "1.0.0",
  "description": "eng4u — Nền tảng luyện thi Cambridge IELTS toàn diện 4 kỹ năng & Học từ vựng Anki",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"nodemon app.js\" \"npm --prefix frontend run dev\"",
    "client": "npm --prefix frontend run dev",
    "server": "nodemon app.js",
    "build": "npm install && npm --prefix frontend install && npm --prefix frontend run build",
    "client:build": "npm --prefix frontend run build",
    "client:preview": "npm --prefix frontend run preview",
    "db:seed:cambridge": "node scripts/seedCambridgeData.js",
    "db:seed:all": "node scripts/seedAllCambridge.js",
    "test": "node scripts/testGradingSystem.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "https-proxy-agent": "^9.1.0",
    "mysql2": "^3.10.0",
    "nodemailer": "^10.1.7",
    "undici": "^8.12.3",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1029.0",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.4"
  }
}
